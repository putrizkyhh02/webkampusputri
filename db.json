  "discussions": [
    {
      "id": "disc_1",
      "title": "Penanganan Masalah Imbalanced Data pada Klasifikasi Medis AI402",
      "category": "Akademik",
      "courseId": "AI402",
      "courseName": "Kecerdasan Buatan & Machine Learning",
      "authorId": "mhs_1",
      "authorName": "Ahmad Zulfikar Pratama",
      "authorRole": "mahasiswa",
      "authorAvatar": "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80",
      "authorSubtext": "NIM 220401001 • Teknik Informatika",
      "createdAt": "2026-10-14T08:30:00",
      "content": "Selamat pagi Pak Hendra dan rekan-rekan. Saat melakukan preprocessing pada data kanker payudara untuk Tugas 1, saya menemukan rasio kelas positif dan negatif adalah 1:9. Model Random Forest cenderung bias ke kelas mayoritas. Apakah dianjurkan menggunakan SMOTE (Synthetic Minority Over-sampling) atau lebih baik memodifikasi Class Weight dan Focal Loss?",
      "upvotes": 14,
      "tags": [
        "Machine Learning",
        "Tugas 1",
        "Imbalanced Data",
        "AI402"
      ],
      "replies": [
        {
          "id": "rep_1_1",
          "authorId": "dos_1",
          "authorName": "Dr. Ir. Hendra Kusuma, M.Kom.",
          "authorRole": "dosen",
          "authorAvatar": "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=150&auto=format&fit=crop&q=80",
          "authorSubtext": "Dosen Pengampu AI402",
          "createdAt": "2026-10-14T09:15:00",
          "content": "Pertanyaan yang sangat bagus Zulfikar. Untuk domain medis di mana false negative berisiko fatal, pendekatan yang direkomendasikan adalah kombinasi: 1) Gunakan Stratified K-Fold CV untuk validasi, 2) Terapkan Class Weighting (misal `class_weight='balanced'`) terlebih dahulu karena tidak menambah synthetic noise, 3) Evaluasi dengan PR-AUC (Precision-Recall Curve) daripada hanya ROC-AUC. SMOTE dapat dicoba, tapi pastikan hanya di-fit pada training fold saja untuk menghindari data leakage.",
          "isVerifiedAnswer": true,
          "upvotes": 21
        },
        {
          "id": "rep_1_2",
          "authorId": "mhs_2",
          "authorName": "Nabila Putri Maharani",
          "authorRole": "mahasiswa",
          "authorAvatar": "https://images.unsplash.com/photo-1517841905240-472988babdf9?w=150&auto=format&fit=crop&q=80",
          "authorSubtext": "NIM 220401045 • Sistem Informasi",
          "createdAt": "2026-10-14T10:02:00",
          "content": "Terima kasih penjelasannya Pak Hendra! Saya sempat mencoba library `imbalanced-learn` dengan pipeline scikit-learn, hasilnya cukup stabil dan mencegah leakage.",
          "isVerifiedAnswer": false,
          "upvotes": 5
        }
      ]
    },
    {
      "id": "disc_2",
      "title": "Perbedaan Karakteristik Partition Key vs Shard Key di Basis Data Terdistribusi",
      "category": "Akademik",
      "courseId": "BDT202",
      "courseName": "Basis Data Terdistribusi",
      "authorId": "mhs_3",
      "authorName": "Dimas Arya Nugroho",
      "authorRole": "mahasiswa",
      "authorAvatar": "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80",
      "authorSubtext": "NIM 230402012 • Rekayasa Perangkat Lunak",
      "createdAt": "2026-10-12T13:45:00",
      "content": "Izin bertanya Bu Ratna, apakah ada kondisi di mana range-based sharding lebih diunggulkan dibanding hashed sharding pada sistem keuangan dengan jutaan transaksi harian?",
      "upvotes": 9,
      "tags": [
        "Distributed DB",
        "Sharding",
        "BDT202"
      ],
      "replies": [
        {
          "id": "rep_2_1",
          "authorId": "dos_2",
          "authorName": "Ratna Widyaningrum, S.T., M.Sc., Ph.D.",
          "authorRole": "dosen",
          "authorAvatar": "https://images.unsplash.com/photo-1580489944761-15a19d654956?w=150&auto=format&fit=crop&q=80",
          "authorSubtext": "Dosen Pengampu BDT202",
          "createdAt": "2026-10-12T14:30:00",
          "content": "Halo Dimas. Range-based sharding sangat unggul ketika aplikasi kamu membutuhkan query rentang waktu (misal: rekap mutasi rekening per bulan/tahun), karena data berdekatan tersimpan pada chunk/shard yang sama. Namun kelemahannya adalah risiko hot-spotting jika data transaksi terbaru selalu masuk ke range tertinggi. Solusinya sering kali menggunakan compound shard key (gabungan hashed customer_id + timestamp).",
          "isVerifiedAnswer": true,
          "upvotes": 18
        }
      ]
    },
